# Copy to .env.prod and fill in every REQUIRED value before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# REQUIRED — Postgres superuser/migration-role password.
POSTGRES_PASSWORD=

# REQUIRED — password for the least-privilege runtime app role (zonovia_app). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DB_PASSWORD=

# REQUIRED — JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated JSON array of allowed CORS origins, e.g. ["https://app.your-domain.example"]
CORS_ORIGINS=[]

# uvicorn worker count
BACKEND_WORKERS=4
