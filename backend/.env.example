ENVIRONMENT=development

# Runtime app connection — the LEAST-PRIVILEGE role (no table ownership), so Postgres RLS
# actually applies to it. See infrastructure/docker/postgres-init.sql and
# migrations/versions/0003_app_role_grants.py.
DATABASE_URL=postgresql+asyncpg://zonovia_app:zonovia_app_password@localhost:5432/zonovia

# Migration connection — the superuser/owner role. Used only by Alembic, never by the app.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/zonovia

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# IP-scoped, Redis-backed — independent of the per-account lockout above (see app/core/rate_limit.py)
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
